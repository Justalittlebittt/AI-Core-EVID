{
  "schema": "AI_CORE_EVID_V2_9_STRATEGY_VALIDITY_BASELINE_CONTRACT_V2",
  "version": "V2.9",
  "status": "FROZEN_BEFORE_REAL_STRATEGY_SCORING",
  "governance_kernel": "evidence/V2.9_GOVERNANCE_KERNEL.json",
  "foundation": "evidence/V2.9_VALIDITY_AND_DISCIPLINE_FOUNDATION.json",
  "integrity_exit_audit": "evidence/V2.9_INTEGRITY_EXIT_AUDIT_RECEIPT.json",
  "evidence_strength_mapping": "evidence/V2.9_EVIDENCE_STRENGTH_MAPPING_CONTRACT.json",
  "purpose": "Define the preregistration and result interface required before strategy-level evidence-strength evaluation, while avoiding universal post-hoc thresholds and avoiding an all-dimensions-must-pass design.",
  "experiment_preregistration": {
    "must_be_frozen_before_outcome_evaluation": true,
    "required_identity_fields": [
      "experiment_id",
      "strategy_version",
      "signal_version",
      "data_vintage_policy",
      "sample_definition",
      "training_or_research_period",
      "untouched_oos_period_or_fold",
      "primary_decision_question"
    ],
    "required_comparison_fields": [
      "simple_baseline",
      "market_or_domain_baseline",
      "primary_metric",
      "primary_horizon",
      "transaction_cost_model",
      "execution_constraints"
    ],
    "required_dimension_plan": [
      "effect_size",
      "baseline_comparison",
      "out_of_sample",
      "regime_stability",
      "cross_sectional_stability",
      "transaction_cost_and_execution_constraints",
      "drawdown_and_loss_sequences",
      "probability_calibration_where_applicable",
      "reasonable_parameter_sensitivity",
      "failure_region_identification"
    ],
    "per_dimension_required_fields": [
      "dimension",
      "role",
      "failure_effect",
      "metric_or_test",
      "predeclared_interpretation_rule",
      "required_data_scope",
      "status_if_data_unavailable"
    ],
    "allowed_dimension_roles": ["ANCHOR", "SUPPORTING"],
    "allowed_failure_effects": ["CAP_AT_WEAK", "CAP_AT_MODERATE", "UNCERTAINTY_ONLY"],
    "required_anchor_dimensions": [
      "baseline_comparison",
      "out_of_sample",
      "transaction_cost_and_execution_constraints"
    ],
    "post_outcome_dimension_deletion_allowed": false,
    "post_outcome_baseline_replacement_allowed": false,
    "post_outcome_primary_metric_change_allowed": false,
    "post_outcome_threshold_relaxation_allowed": false,
    "post_outcome_role_or_failure_effect_change_allowed": false
  },
  "result_interface": {
    "dimension_status_values": [
      "SUPPORTED",
      "MIXED_OR_UNSTABLE",
      "FAILED",
      "INSUFFICIENT_DATA",
      "NOT_APPLICABLE_PREDECLARED"
    ],
    "required_result_fields_per_dimension": [
      "dimension",
      "status",
      "observed_metric_summary",
      "predeclared_rule_applied",
      "data_scope_used",
      "caveats"
    ],
    "evidence_strength_levels": ["STRONG", "MODERATE", "WEAK", "INSUFFICIENT"],
    "synthesis_v2": {
      "principle": "Dimension statuses are synthesized according to preregistered role and failure_effect. A single ordinary supporting weakness does not automatically force WEAK.",
      "INSUFFICIENT": [
        "Integrity prerequisite fails or is indeterminate.",
        "No untouched OOS evaluation exists when required.",
        "Primary baseline comparison is missing.",
        "A predeclared minimum sample or resolved-data floor fails.",
        "A required ANCHOR dimension has INSUFFICIENT_DATA.",
        "Any system-critical result identity or temporal binding is unresolved."
      ],
      "WEAK": [
        "A preregistered dimension with failure_effect=CAP_AT_WEAK fails.",
        "This is reserved for weaknesses that materially undermine the core baseline-relative, OOS or post-cost claim."
      ],
      "MODERATE": [
        "One or more SUPPORTING dimensions fail or are mixed under CAP_AT_MODERATE/UNCERTAINTY_ONLY semantics.",
        "An ANCHOR dimension is MIXED_OR_UNSTABLE but not failed.",
        "Material uncertainty remains while the core baseline-relative/OOS/post-cost claim is not invalidated."
      ],
      "STRONG": [
        "All applicable preregistered dimensions are SUPPORTED and all mandatory integrity/sample/OOS/baseline prerequisites pass."
      ],
      "no_failure_count_rule": true,
      "no_all_soft_dimensions_must_pass_rule": true
    },
    "automatic_upgrade_from_point_estimate_only": false,
    "single_metric_can_determine_STRONG": false
  },
  "baseline_policy": {
    "simple_baseline_must_remain_visible": true,
    "complex_strategy_without_simple_baseline": "INSUFFICIENT",
    "baseline_may_not_be_replaced_after_results": true,
    "matched_random_baseline_scope": "CONDITIONAL_SELECTION_ONLY"
  },
  "coverage_policy": {
    "coverage_must_be_preregistered": true,
    "near_zero_action_rate_triggers_usability_review": true,
    "near_zero_action_rate_automatically_strengthens_claim": false,
    "no_universal_selection_rate_floor": true,
    "post_outcome_coverage_relaxation_allowed": false
  },
  "uncertainty_policy": {
    "small_sample": "RESEARCH_UNCERTAINTY_NOT_ENGINEERING_DEFECT",
    "wide_interval": "RESEARCH_UNCERTAINTY_NOT_ENGINEERING_DEFECT",
    "regime_instability": "REPORT_AS_VALIDITY_WEAKNESS",
    "parameter_sensitivity": "REPORT_AS_VALIDITY_WEAKNESS",
    "external_provider_failure": "EXTERNAL_OPERATIONAL_UNLESS_IT_CHANGES_SAMPLE_TIME_RULES_OR_DISCIPLINE"
  },
  "governance": {
    "no_new_hard_gate_created_by_this_contract": true,
    "historical_V2_8_12R_evidence_changed": false,
    "prospective_lane_changed": false,
    "fold3_or_fold4_access_authorized": false,
    "discipline_engine_action_authorized": false,
    "real_strategy_scoring_completed": false
  },
  "next_stage": "SYNTHETIC_VALIDATE_SYNTHESIS_V2_THEN_WAIT_FOR_ELIGIBLE_REAL_PREREGISTRATION"
}
